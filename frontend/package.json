    "lucide-react": "0.555.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "5.9.3",
