# Lokale Entwicklungswerte. Einrichten mit: cp .env.example .env
#
# Die Werte funktionieren direkt, sind aber nur für die lokale Entwicklung
# gedacht. Die .env selbst wird nie eingecheckt; dort landen später auch
# echte Zugangsdaten (z. B. für das LLM). Echte Umgebungsvariablen haben
# Vorrang vor Werten aus der .env.

# Django
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL – dieselben Namen liest auch das offizielle postgres-Image.
# POSTGRES_HOST/PORT gelten für den Start ohne Docker; Docker Compose
# setzt für das Backend selbst db:5432.
POSTGRES_DB=traveller
POSTGRES_USER=traveller
POSTGRES_PASSWORD=traveller-dev-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend in Docker: auf true setzen, falls Änderungen im Container nicht
# ankommen (z. B. Windows mit Projekt außerhalb von WSL)
WATCH_POLLING=false
